import asyncio
import os
import re

import httpx
import yaml
from dotenv import load_dotenv
from rich.console import Console
from rich.table import Table

from pracuj import search_pracuj


load_dotenv()

console = Console()

TOP_JOBS = 30

ADZUNA_BASE_URL = "https://api.adzuna.com/v1/api/jobs/pl/search/1"


# ============================================================
# PROFILE
# ============================================================

with open("profile.yaml", "r", encoding="utf-8") as f:
    PROFILE = yaml.safe_load(f)

LOCATION = PROFILE.get("location", "Warsaw")

QUERIES = PROFILE.get(
    "queries",
    [
        "infrastructure engineer",
        "network engineer",
        "systems engineer",
        "cloud infrastructure",
        "platform engineer",
        "devops engineer",
        "network operations",
    ],
)

SALARY_MIN = PROFILE.get("salary", {}).get("minimum", 12000)
SALARY_TARGET = PROFILE.get("salary", {}).get("target", 16000)
SALARY_MAX = PROFILE.get("salary", {}).get("maximum", 20000)


# ============================================================
# ADZUNA
# ============================================================

async def search_adzuna(query):
    app_id = os.getenv("ADZUNA_APP_ID")
    app_key = os.getenv("ADZUNA_APP_KEY")

    if not app_id or not app_key:
        raise RuntimeError(
            "ADZUNA_APP_ID / ADZUNA_APP_KEY missing in .env"
        )

    params = {
        "app_id": app_id,
        "app_key": app_key,
        "results_per_page": 50,
        "what": query,
        "where": LOCATION,
        "content-type": "application/json",
    }

    async with httpx.AsyncClient(timeout=30) as client:
        response = await client.get(
            ADZUNA_BASE_URL,
            params=params,
        )

        response.raise_for_status()

        data = response.json()

    jobs = []

    for item in data.get("results", []):
        salary_min = item.get("salary_min")
        salary_max = item.get("salary_max")

        jobs.append(
            {
                "title": item.get("title", ""),
                "company": (
                    item.get("company", {}).get("display_name", "")
                    if isinstance(item.get("company"), dict)
                    else str(item.get("company", ""))
                ),
                "location": (
                    item.get("location", {}).get("display_name", "")
                    if isinstance(item.get("location"), dict)
                    else str(item.get("location", ""))
                ),
                "description": item.get("description", ""),
                "url": item.get("redirect_url", ""),
                "salary": {
                    "min": salary_min,
                    "max": salary_max,
                },
                "source": "adzuna",
            }
        )

    return jobs


# ============================================================
# NORMALIZATION
# ============================================================

def normalize_text(value):
    if not value:
        return ""

    value = str(value).lower()

    value = value.replace("â€“", "-")
    value = value.replace("â€”", "-")
    value = value.replace("â€™", "'")
    value = value.replace("\n", " ")
    value = value.replace("\t", " ")

    return re.sub(r"\s+", " ", value).strip()


def normalize_company(company):
    company = normalize_text(company)

    company = re.sub(
        r"\b(sp\.?\s*z\.?\s*o\.?\s*o\.?|s\.?a\.?|ltd\.?|inc\.?|llc)\b",
        "",
        company,
    )

    return re.sub(r"\s+", " ", company).strip()


def normalize_title(title):
    return normalize_text(title)


# ============================================================
# DEDUPLICATION
# ============================================================

def job_key(job):
    return (
        normalize_title(job.get("title")),
        normalize_company(job.get("company")),
        normalize_text(job.get("location")),
    )


def deduplicate(jobs):
    result = {}

    for job in jobs:
        key = job_key(job)

        if key not in result:
            result[key] = job
            continue

        existing = result[key]

        existing_min, existing_max = get_salary_range(existing)
        new_min, new_max = get_salary_range(job)

        existing_has_salary = (
            existing_min is not None or existing_max is not None
        )

        new_has_salary = (
            new_min is not None or new_max is not None
        )

        if new_has_salary and not existing_has_salary:
            result[key] = job

    return list(result.values())


# ============================================================
# SALARY
# ============================================================

def get_salary_range(job):
    salary = job.get("salary")

    if not salary:
        return None, None

    if isinstance(salary, dict):
        minimum = salary.get("min")
        maximum = salary.get("max")

    else:
        return None, None

    try:
        minimum = (
            float(minimum)
            if minimum is not None
            else None
        )

        maximum = (
            float(maximum)
            if maximum is not None
            else None
        )

    except (TypeError, ValueError):
        return None, None

    # Adzuna can return annual figures.
    if minimum and minimum > 50000:
        minimum /= 12

    if maximum and maximum > 50000:
        maximum /= 12

    return minimum, maximum


def salary_status(job):
    minimum, maximum = get_salary_range(job)

    if minimum is None and maximum is None:
        return "UNKNOWN"

    if minimum is not None and minimum < 1000:
        return "INVALID"

    if maximum is not None and maximum > 60000:
        return "INVALID"

    if (
        minimum is not None
        and maximum is not None
        and minimum > 0
        and maximum / minimum > 5
    ):
        return "INVALID"

    if minimum is None:
        minimum = maximum

    if maximum is None:
        maximum = minimum

    if maximum < SALARY_MIN:
        return "BELOW"

    if minimum > SALARY_MAX:
        return "ABOVE"

    if minimum >= SALARY_TARGET:
        return "TARGET"

    return "OK"


def salary_score(job):
    status = salary_status(job)

    if status == "TARGET":
        return 15

    if status == "OK":
        return 10

    if status == "ABOVE":
        return 5

    if status == "BELOW":
        return -15

    if status == "INVALID":
        return -20

    return 0


# ============================================================
# HARD REJECT
# ============================================================

PURE_SOFTWARE_PATTERNS = [
    r"\bfrontend\b",
    r"\bfront-end\b",
    r"\bbackend\b",
    r"\bback-end\b",
    r"\bfull[- ]stack\b",
    r"\bmobile developer\b",
    r"\bsoftware developer\b",
    r"\bsoftware engineer\b",
    r"\bapplication developer\b",
    r"\bdata scientist\b",
    r"\bdata analyst\b",
    r"\bmachine learning\b",
    r"\bml engineer\b",
    r"\bpython developer\b",
    r"\bjava developer\b",
    r"\bphp developer\b",
    r"\bjavascript developer\b",
    r"\breact developer\b",
    r"\bdatabase developer\b",
]

INFRA_CONTEXT = [
    "infrastructure",
    "network",
    "networking",
    "systems",
    "linux",
    "cloud",
    "platform",
    "devops",
    "sre",
    "site reliability",
    "noc",
    "operations",
    "it operations",
    "telecommunications",
    "telecom",
    "vpn",
    "firewall",
    "routing",
    "switching",
    "kubernetes",
    "terraform",
    "ansible",
    "azure",
    "aws",
    "gcp",
]


def hard_reject(job):
    title = normalize_text(job.get("title"))
    description = normalize_text(job.get("description"))

    text = f"{title} {description}"

    for pattern in PURE_SOFTWARE_PATTERNS:
        if re.search(pattern, text):
            infrastructure_hits = sum(
                1
                for keyword in INFRA_CONTEXT
                if keyword in text
            )

            if infrastructure_hits < 4:
                return True, "software-heavy role"

    return False, None


# ============================================================
# ROLE FIT
# ============================================================

ROLE_PATTERNS = {
    "cloud infrastructure engineer": 40,
    "infrastructure engineer": 38,
    "it infrastructure engineer": 38,
    "systems engineer": 35,
    "system engineer": 35,
    "network engineer": 35,
    "network operations": 34,
    "platform engineer": 32,
    "cloud engineer": 32,
    "devops engineer": 28,
    "site reliability engineer": 27,
    "telecommunications infrastructure engineer": 38,
    "telecommunications engineer": 32,
    "ip network engineer": 36,
    "network operations engineer": 35,
}


def role_score(job):
    title = normalize_title(job.get("title"))

    score = 0

    for pattern, points in ROLE_PATTERNS.items():
        if pattern in title:
            score = max(score, points)

    if "infrastructure" in title:
        score = max(score, 32)

    if "network engineer" in title:
        score = max(score, 35)

    if "systems engineer" in title:
        score = max(score, 34)

    if "system engineer" in title:
        score = max(score, 34)

    if "platform engineer" in title:
        score = max(score, 30)

    if "cloud" in title and "engineer" in title:
        score = max(score, 30)

    if "devops" in title:
        score = max(score, 27)

    return min(score, 40)


# ============================================================
# TECHNOLOGY FIT
# ============================================================

TECH_KEYWORDS = {
    "linux": 5,
    "ubuntu": 3,
    "sles": 3,
    "unix": 2,

    "networking": 5,
    "tcp/ip": 4,
    "tcp": 2,
    "ip network": 5,
    "routing": 4,
    "switching": 4,
    "vlan": 4,
    "bgp": 3,
    "ospf": 3,
    "dns": 3,
    "dhcp": 3,
    "firewall": 4,
    "vpn": 4,
    "wireshark": 3,
    "cisco": 4,
    "juniper": 4,
    "lan": 3,
    "wan": 3,
    "wifi": 3,

    "aws": 5,
    "azure": 5,
    "gcp": 5,
    "google cloud": 5,

    "terraform": 5,
    "ansible": 4,
    "docker": 4,
    "kubernetes": 5,
    "git": 2,
    "ci/cd": 3,

    "monitoring": 3,
    "zabbix": 3,
    "prometheus": 3,
    "grafana": 3,
    "observability": 3,

    "storage": 5,
    "san": 4,
    "nas": 3,
    "iscsi": 4,
    "raid": 3,
    "virtualization": 4,
    "vmware": 3,
    "hyper-v": 3,
}


def technology_score(job):
    title = normalize_text(job.get("title"))
    description = normalize_text(job.get("description"))

    text = f"{title} {description}"

    score = 0

    for keyword, points in TECH_KEYWORDS.items():
        if keyword in text:
            score += points

    return min(score, 30)


# ============================================================
# SENIORITY
# ============================================================

def seniority_score(job):
    title = normalize_title(job.get("title"))
    description = normalize_text(job.get("description"))

    text = f"{title} {description}"

    score = 0

    if re.search(r"\bjunior\b", text):
        score += 3

    elif re.search(r"\bmid\b|\bmiddle\b|\bregular\b", text):
        score += 12

    elif re.search(r"\bsenior\b", text):
        score += 7

    elif re.search(r"\bexpert\b", text):
        score += 3

    elif re.search(r"\bstaff\b", text):
        score -= 3

    elif re.search(r"\bprincipal\b", text):
        score -= 5

    elif re.search(r"\blead\b", text):
        score -= 4

    elif re.search(r"\barchitect\b", text):
        score -= 5

    years = []

    for match in re.findall(
        r"(\d+)\+?\s*(?:years?|yrs?)",
        text,
    ):
        try:
            years.append(int(match))
        except ValueError:
            pass

    if years:
        required = max(years)

        if required <= 2:
            score += 2

        elif required == 3:
            score += 5

        elif required == 4:
            score += 1

        elif required == 5:
            score -= 4

        elif required >= 6:
            score -= 8

    return max(-10, min(score, 15))


# ============================================================
# PENALTIES
# ============================================================

def penalty_score(job):
    title = normalize_title(job.get("title"))
    description = normalize_text(job.get("description"))

    text = f"{title} {description}"

    penalty = 0
    reasons = []

    software_signals = [
        "software developer",
        "frontend",
        "front-end",
        "backend developer",
        "back-end developer",
        "full-stack developer",
        "mobile developer",
        "data scientist",
        "data analyst",
        "machine learning engineer",
    ]

    for signal in software_signals:
        if signal in text:
            penalty -= 20
            reasons.append(f"{signal} (-20)")
            break

    leadership_signals = [
        "solution architect",
        "solutions architect",
        "enterprise architect",
        "network architect",
        "technical lead",
        "team lead",
        "principal engineer",
    ]

    for signal in leadership_signals:
        if signal in text:
            penalty -= 10
            reasons.append(f"{signal} (-10)")
            break

    if re.search(
        r"\b(7|8|9|10)\+?\s*(?:years?|yrs?)",
        text,
    ):
        penalty -= 10
        reasons.append(
            "very high experience requirement (-10)"
        )

    if salary_status(job) == "INVALID":
        penalty -= 15
        reasons.append("invalid salary data (-15)")

    return penalty, reasons


# ============================================================
# COMPLETE SCORE
# ============================================================

def score_job(job):
    rejected, reason = hard_reject(job)

    if rejected:
        return None

    role = role_score(job)
    tech = technology_score(job)
    senior = seniority_score(job)
    salary = salary_score(job)
    penalty, penalty_reasons = penalty_score(job)

    total = (
        role
        + tech
        + senior
        + salary
        + penalty
    )

    job["_score"] = total
    job["_role_score"] = role
    job["_tech_score"] = tech
    job["_senior_score"] = senior
    job["_salary_score"] = salary
    job["_penalty"] = penalty
    job["_penalty_reasons"] = penalty_reasons
    job["_salary_status"] = salary_status(job)

    return job


# ============================================================
# DISPLAY
# ============================================================

def format_salary(job):
    minimum, maximum = get_salary_range(job)

    if minimum is None and maximum is None:
        return "unknown"

    if minimum is None:
        return f"{maximum:,.0f}"

    if maximum is None:
        return f"{minimum:,.0f}"

    return f"{minimum:,.0f}â€“{maximum:,.0f}"


def print_table(jobs):
    table = Table(title="Top Job Matches")

    table.add_column("#", justify="right")
    table.add_column("Score", justify="right")
    table.add_column("Title", max_width=48)
    table.add_column("Company", max_width=28)
    table.add_column("Salary", justify="right")
    table.add_column("Status")
    table.add_column("Source")

    for index, job in enumerate(
        jobs[:TOP_JOBS],
        start=1,
    ):
        table.add_row(
            str(index),
            str(job["_score"]),
            job.get("title", "unknown"),
            job.get("company", "unknown"),
            format_salary(job),
            job.get("_salary_status", "UNKNOWN"),
            job.get("source", "unknown"),
        )

    console.print()
    console.print(table)


def print_analysis(jobs):
    console.print()
    console.print("Top 10 analysis")
    console.print()

    for index, job in enumerate(
        jobs[:10],
        start=1,
    ):
        console.print(
            f"{index}. {job.get('title', 'unknown')}"
        )

        console.print(
            f"   Company: {job.get('company', 'unknown')}"
        )

        console.print(
            f"   Score: {job['_score']}"
        )

        console.print(
            f"   Role: {job['_role_score']} | "
            f"Tech: {job['_tech_score']} | "
            f"Senior: {job['_senior_score']} | "
            f"Salary: {job['_salary_score']} | "
            f"Penalty: {job['_penalty']}"
        )

        console.print(
            f"   Salary: {job['_salary_status']}"
        )

        if job["_penalty_reasons"]:
            console.print(
                "   Penalties: "
                + ", ".join(
                    job["_penalty_reasons"]
                )
            )

        console.print(
            f"   URL: {job.get('url', '')}"
        )

        console.print()


# ============================================================
# MAIN SEARCH
# ============================================================

async def main():
    console.print()
    console.print("JOB AGENT")
    console.print("Searching Adzuna + Pracuj...")
    console.print()

    adzuna_jobs = []

    for query in QUERIES:
        try:
            jobs = await search_adzuna(query)

            console.print(
                f"[Adzuna] {query}: {len(jobs)}"
            )

            adzuna_jobs.extend(jobs)

        except Exception as exc:
            console.print(
                f"[Adzuna] {query}: ERROR - {exc}"
            )

    console.print()

    try:
        pracuj_jobs = await asyncio.to_thread(
            search_pracuj, "infrastructure engineer"
        )
    except Exception as exc:
        console.print(
            f"[Pracuj] ERROR - {exc}"
        )
        pracuj_jobs = []

    console.print(
        f"Adzuna raw: {len(adzuna_jobs)}"
    )

    console.print(
        f"Pracuj raw: {len(pracuj_jobs)}"
    )

    all_jobs = (
        adzuna_jobs
        + pracuj_jobs
    )

    all_jobs = deduplicate(all_jobs)

    console.print(
        f"Unique jobs: {len(all_jobs)}"
    )

    scored_jobs = []

    rejected_count = 0

    for job in all_jobs:
        scored = score_job(job)

        if scored is None:
            rejected_count += 1
            continue

        scored_jobs.append(scored)

    scored_jobs.sort(
        key=lambda job: job["_score"],
        reverse=True,
    )

    console.print(
        f"Rejected as clearly mismatched: "
        f"{rejected_count}"
    )

    print_table(scored_jobs)

    print_analysis(scored_jobs)


if __name__ == "__main__":
    asyncio.run(main())


